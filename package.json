{
  "name": "dsh-issues",
  "version": "0.1.0",
  "description": "Internal issue tracker for DeepSeek Harness: create issues per project and let agents work on them.",
  "license": "MIT",
  "type": "module",
  "main": "src/plugin.mjs",
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "client.js"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "exports": {
    ".": "./src/plugin.mjs",
    "./http": "./src/http-plugin.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js"
  }
}
